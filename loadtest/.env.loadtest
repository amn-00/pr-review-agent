# Settings for the load-test stack (loadtest/docker-compose.yml). Every value is fake on
# purpose: nothing here works against the real GitHub or Groq. Safe to commit.
ENVIRONMENT=dev
LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/pr_review_load

GITHUB_APP_ID=1
# Not used: the load-test worker signs with a key it generates at startup.
GITHUB_APP_PRIVATE_KEY=not-a-key
GITHUB_WEBHOOK_SECRET=loadtest-webhook-secret
GROQ_API_KEY=not-a-key

SEMGREP_ENABLED=false
AGENT_ENABLED=true

LOADTEST_FAKES_URL=http://fakes:9000
