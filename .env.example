# Copy to .env and fill in. Never commit .env.
# Setup steps for the GitHub App: docs/github-app-setup.md

# dev | test | prod
ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Used when running on the host. docker-compose overrides these with service hostnames.
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pr_review

# GitHub App (required)
GITHUB_APP_ID=123456
# The App's private key on ONE line, newlines written as \n. See docs/github-app-setup.md.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_WEBHOOK_SECRET=change-me

# Groq (required). Create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_change-me
# Optional. Both must support strict structured outputs. The main model runs the correctness
# and security lanes; the small one runs maintainability (each model has its own rate limits).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SMALL_MODEL=openai/gpt-oss-20b

# Optional. Semgrep needs its own install (docker build --build-arg WITH_SEMGREP=true) and a
# few hundred MB of memory. Ruff always runs.
SEMGREP_ENABLED=false

# Optional. The verification agent checks each finding against the repo before it's posted.
# false = pipeline only (every finding that passes aggregation is posted).
AGENT_ENABLED=true

# Optional. Run the arq worker inside the API process (prod on Render's free tier, which has no
# background workers). Leave false locally: docker-compose runs the worker as its own container.
RUN_WORKER_IN_API=false
