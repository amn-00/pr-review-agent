# Copy to .env and fill in. Never commit .env.
# Setup steps for the GitHub App: docs/github-app-setup.md

# dev | test | prod
ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Used when running on the host. docker-compose overrides these with service hostnames.
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pr_review

# GitHub App (required)
GITHUB_APP_ID=123456
# The App's private key on ONE line, newlines written as \n. See docs/github-app-setup.md.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_WEBHOOK_SECRET=change-me

# Groq (required). Create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_change-me
# Optional. Both must support strict structured outputs. The main model runs the correctness
# and security lanes; the small one runs maintainability (each model has its own rate limits).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SMALL_MODEL=openai/gpt-oss-20b
